# Novel Builder 环境变量配置
# 复制此文件为 .env 并填写实际值

# ===========================================
# 核心配置（必需）
# ===========================================

# API 访问令牌 - 用于保护后端 API
NOVEL_API_TOKEN=your_secure_api_token_here

# 数据库连接字符串
DATABASE_URL=postgresql://novel_user:novel_pass@postgres:5432/novel_db
# 注意：DATABASE_URL 字符串内嵌的 novel_user / novel_pass / novel_db 必须与下方
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB 三项一致，否则 Postgres 容器会
# 拒绝连接。

# ===========================================
# 数据库配置
# ===========================================

POSTGRES_DB=novel_db
POSTGRES_USER=novel_user
POSTGRES_PASSWORD=secure_password_here

# ===========================================
# 服务器配置
# ===========================================

# 调试模式（生产环境设置为 false）
DEBUG=false

# ===========================================
# AI 功能配置
# ===========================================

# ComfyUI 服务 - AI 图片/视频生成
COMFYUI_API_URL=http://host.docker.internal:8188

# ComfyUI 模型目录（容器内路径，需与 volumes 挂载点一致）
COMFYUI_MODELS_DIR=/app/models

# ===========================================
# 代理配置（可选）
# ===========================================

# HTTP 代理（如果需要）
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080

# ===========================================
# 安全配置
# ===========================================

# CORS 允许的源（逗号分隔字符串；后端按 split(",") 解析）
# 注意：必须是纯字符串格式（不带方括号 []），与后端 Settings 默认值同形
CORS_ORIGINS=http://localhost:3154